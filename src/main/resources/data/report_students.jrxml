<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="report_students"
        pageWidth="595"
        pageHeight="842"
        columnWidth="555"
        leftMargin="20"
        rightMargin="20"
        topMargin="20"
        bottomMargin="20"
    uuid="a1b2c3d4-e5f6-7890-1111-222222222222">

    <!-- ========================= -->
    <!-- PARAMETERS (opcionales)   -->
    <!-- ========================= -->
    <parameter name="createdBy" class="java.lang.String"/>

    <!-- ========================= -->
    <!-- FIELDS (TU MODELO)        -->
    <!-- ========================= -->
    <field name="curso" class="java.lang.String"/>
    <field name="profesor" class="java.lang.String"/>
    <field name="carrera" class="java.lang.String"/>
    <field name="estudiantes" class="java.lang.Integer"/>
    <field name="promedio" class="java.lang.Double"/>
    <field name="aprobados" class="java.lang.Integer"/>
    <field name="reprobados" class="java.lang.Integer"/>

    <!-- ========================= -->
    <!-- TITLE                    -->
    <!-- ========================= -->
    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[REPORTE ACADÉMICO]]></text>
            </staticText>
        </band>
    </title>

    <!-- ========================= -->
    <!-- COLUMN HEADER            -->
    <!-- ========================= -->
    <columnHeader>
        <band height="30">

            <staticText><reportElement x="0" y="0" width="80" height="30"/>
                <text><![CDATA[Curso]]></text>
            </staticText>

            <staticText><reportElement x="80" y="0" width="90" height="30"/>
                <text><![CDATA[Profesor]]></text>
            </staticText>

            <staticText><reportElement x="170" y="0" width="90" height="30"/>
                <text><![CDATA[Carrera]]></text>
            </staticText>

            <staticText><reportElement x="260" y="0" width="60" height="30"/>
                <text><![CDATA[Est.]]></text>
            </staticText>

            <staticText><reportElement x="320" y="0" width="60" height="30"/>
                <text><![CDATA[Prom]]></text>
            </staticText>

            <staticText><reportElement x="380" y="0" width="70" height="30"/>
                <text><![CDATA[Aprob]]></text>
            </staticText>

            <staticText><reportElement x="450" y="0" width="80" height="30"/>
                <text><![CDATA[Reprob]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- ========================= -->
    <!-- DETAIL (DATA)            -->
    <!-- ========================= -->
    <detail>
        <band height="25">

            <textField>
                <reportElement x="0" y="0" width="80" height="25"/>
                <textFieldExpression><![CDATA[$F{curso}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="80" y="0" width="90" height="25"/>
                <textFieldExpression><![CDATA[$F{profesor}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="170" y="0" width="90" height="25"/>
                <textFieldExpression><![CDATA[$F{carrera}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="260" y="0" width="60" height="25"/>
                <textFieldExpression><![CDATA[$F{estudiantes}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="320" y="0" width="60" height="25"/>
                <textFieldExpression><![CDATA[$F{promedio}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="380" y="0" width="70" height="25"/>
                <textFieldExpression><![CDATA[$F{aprobados}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="450" y="0" width="80" height="25"/>
                <textFieldExpression><![CDATA[$F{reprobados}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- ========================= -->
    <!-- FOOTER                   -->
    <!-- ========================= -->
    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Generado por: " + $P{createdBy}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>