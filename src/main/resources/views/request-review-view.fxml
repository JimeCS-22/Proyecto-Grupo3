<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.ucr.sga.controller.RequestReviewController">

    <!-- ===== HEADER ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header-bar">
            <padding>
                <Insets bottom="18" left="24" right="24" top="18" />
            </padding>

            <Label styleClass="header-badge" text="SGA" />

            <VBox spacing="2">
                <Label styleClass="header-title" text="Revisión de Solicitudes" />
                <Label styleClass="header-sub" text="Administra las solicitudes de matrícula de los estudiantes" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <!-- ===== CONTENT ===== -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" vbarPolicy="AS_NEEDED">
            <VBox spacing="20">
                <padding>
                    <Insets bottom="25" left="25" right="25" top="25" />
                </padding>

                <VBox spacing="15" styleClass="card">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="3">
                            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Solicitudes de Matrícula" />
                            <Label styleClass="subtitle" text="Solicitudes en estado pendiente" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="badge" text="Revisión" />
                    </HBox>

                    <TableView fx:id="tblRequests" prefHeight="416.0" prefWidth="900.0">
                        <columns>
                            <TableColumn fx:id="colStudent" prefWidth="224.0" text="Estudiante" />
                            <TableColumn fx:id="colCourses" prefWidth="216.0" text="Cursos Solicitados" />
                            <TableColumn fx:id="colPriority" prefWidth="72.0" text="Prioridad" />
                            <TableColumn fx:id="colStatus" prefWidth="108.0" text="Estado" />
                            <TableColumn fx:id="colActions" prefWidth="270.0" text="Acción" />
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
