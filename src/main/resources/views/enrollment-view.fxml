<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<BorderPane styleClass="root" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.ucr.sga.controller.EnrollmentController">

    <!-- =========================
         HEADER
    ========================== -->

    <top>

        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header-bar">

            <padding>
                <Insets bottom="18" left="24" right="24" top="18" />
            </padding>

            <Label styleClass="header-badge" text="SGA" />

            <VBox spacing="2">

                <Label styleClass="header-title" text="Matrícula Académica" />

                <Label styleClass="header-sub" text="Asignación de cursos a estudiantes" />

            </VBox>

        </HBox>

    </top>

    <!-- =========================
         CONTENT
    ========================== -->

    <center>
        <ScrollPane fitToWidth="true" pannable="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20">

                <padding>
                    <Insets bottom="25" left="25" right="25" top="25" />
                </padding>

                <!-- FORM -->

                <VBox prefHeight="280.0" prefWidth="734.0" spacing="20" styleClass="card">

                    <Label style="-fx-font-size: 20px;                               -fx-font-weight: bold;" text="Asignar Curso" />

                    <!-- ESTUDIANTE -->

                    <VBox spacing="8">

                        <Label styleClass="subtitle" text="Seleccionar Estudiante" />

                        <ComboBox fx:id="cmbStudents" promptText="Seleccione un estudiante" />
                    </VBox>

                    <!-- CURSO -->

                    <VBox spacing="8">

                        <Label styleClass="subtitle" text="Seleccionar Curso" />

                        <ComboBox fx:id="cmbCourses" promptText="Seleccione un curso" />

                        <!-- BUTTON -->

                        <Button onAction="#assignCourse" styleClass="btn-success" text="Asignar Curso" />
                    </VBox>

                </VBox>

                <!-- TABLE -->

                <VBox spacing="15" styleClass="card" prefWidth="734.0">
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Cursos Asignados" />
                    <TableView fx:id="tblEnrollments"
                               prefHeight="170.0"
                               minHeight="100.0"
                               VBox.vgrow="ALWAYS"
                               styleClass="custom-table">
                        <columns>
                            <TableColumn fx:id="colStudent" prefWidth="230" text="Estudiante" />
                            <TableColumn fx:id="colCourse" prefWidth="230" text="Curso" />
                            <TableColumn fx:id="colCredits" prefWidth="100" text="Créditos" />
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>