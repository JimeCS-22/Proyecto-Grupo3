<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root" stylesheets="@../styles.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="cr.ac.ucr.sga.controller.EnrollmentController">

    <!-- =========================
         HEADER
    ========================== -->

    <top>

        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header-bar">

            <padding>
                <Insets bottom="18" left="24" right="24" top="18" />
            </padding>

            <Label styleClass="header-badge" text="SGA" />

            <VBox spacing="2">

                <Label styleClass="header-title" text="Matrícula Académica" />

                <Label styleClass="header-sub" text="Asignación de cursos a estudiantes" />

            </VBox>

        </HBox>

    </top>

    <!-- =========================
         CONTENT
    ========================== -->

    <center>

        <VBox spacing="20">

            <padding>
                <Insets bottom="25" left="25" right="25" top="25" />
            </padding>

            <!-- FORM -->

            <VBox prefHeight="259.0" prefWidth="734.0" spacing="20" styleClass="card">

                <Label style="-fx-font-size: 20px;                               -fx-font-weight: bold;" text="Asignar Curso" />

                <!-- ESTUDIANTE -->

                <VBox spacing="8">

                    <Label styleClass="subtitle" text="Seleccionar Estudiante" />

                    <ComboBox fx:id="cmbStudents" promptText="Seleccione un estudiante" />
                </VBox>

                <!-- CURSO -->

                <VBox spacing="8">

                    <Label styleClass="subtitle" text="Seleccionar Curso" />

                    <ComboBox fx:id="cmbCourses" promptText="Seleccione un curso" />
                </VBox>

                <!-- BUTTON -->

                <Button onAction="#assignCourse" styleClass="btn-success" text="Asignar Curso" />

            </VBox>

            <!-- TABLE -->

            <VBox spacing="15" styleClass="card">

                <Label style="-fx-font-size: 18px;                               -fx-font-weight: bold;" text="Cursos Asignados" />

                <TableView fx:id="tblEnrollments" prefHeight="350">

                    <columns>

                        <TableColumn fx:id="colStudent" prefWidth="280" text="Estudiante" />

                        <TableColumn fx:id="colCourse" prefWidth="280" text="Curso" />

                        <TableColumn fx:id="colCredits" prefWidth="120" text="Créditos" />

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </center>

</BorderPane>
