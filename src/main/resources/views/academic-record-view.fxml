<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<BorderPane styleClass="root" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.ucr.sga.controller.RecordController">

    <!-- =========================
         HEADER
    ========================== -->

    <top>

        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header-bar">

            <padding>
                <Insets bottom="18" left="24" right="24" top="18" />
            </padding>

            <Label styleClass="header-badge" text="SGA" />

            <VBox spacing="2">

                <Label styleClass="header-title" text="Expediente Académico" />

                <Label styleClass="header-sub" text="Historial ordenado cronológicamente" />

                <Label fx:id="lblStudentInfo" styleClass="header-badge" />

            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- SOLO ADMIN -->

            <VBox alignment="CENTER_RIGHT" spacing="5">

                <Label styleClass="subtitle" text="Seleccionar estudiante" />

                <ComboBox fx:id="cmbStudents" onAction="#onStudentSelected" prefWidth="250" />

            </VBox>

            <Button onAction="#exportPDF" styleClass="btn-secondary" text="Exportar PDF" />

        </HBox>

    </top>

    <!-- =========================
         CONTENT
    ========================== -->

    <center>
        <ScrollPane fitToWidth="true" pannable="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20">

                <padding>
                    <Insets bottom="25" left="25" right="25" top="25" />
                </padding>

                <!-- RESUMEN -->

                <HBox prefHeight="113.0" prefWidth="854.0" spacing="20">

                    <!-- PROMEDIO -->

                    <VBox prefHeight="122.0" prefWidth="202.0" spacing="10" styleClass="card">

                        <Label styleClass="subtitle" text="Promedio General" />

                        <Label fx:id="lblAvg" style="-fx-font-size:32px;                                   -fx-font-weight:bold;                                   -fx-text-fill:#5562EA;" />

                        <Label fx:id="lblAvgDesc" styleClass="badge" />

                    </VBox>

                    <!-- CREDITOS -->

                    <VBox prefHeight="134.0" prefWidth="186.0" spacing="10" styleClass="card">

                        <Label styleClass="subtitle" text="Créditos Aprobados" />

                        <Label fx:id="lblCredits" style="-fx-font-size:32px;                                   -fx-font-weight:bold;                                   -fx-text-fill:#2DBE8D;" />

                        <Label fx:id="lblCreditosDesc" styleClass="badge" />

                    </VBox>

                    <!-- CURSOS -->

                    <VBox prefHeight="133.0" prefWidth="198.0" spacing="10" styleClass="card">

                        <Label styleClass="subtitle" text="Cursos Matriculados" />

                        <Label fx:id="lblCount" style="-fx-font-size:32px;                                   -fx-font-weight:bold;                                   -fx-text-fill:#E85D75;" />

                        <Label fx:id="lblCiclo" styleClass="badge" />

                    </VBox>

                </HBox>

                <!-- FILTROS -->

                <HBox alignment="CENTER_LEFT" prefHeight="30.0" prefWidth="854.0" spacing="15">

                    <TextField fx:id="txtSearch" prefWidth="250" promptText="Buscar curso..." />

                    <ComboBox fx:id="cmbCycle" prefWidth="180" promptText="Filtrar por ciclo" />

                    <ComboBox fx:id="cmbStatusFilter" prefWidth="180" promptText="Estado" />

                    <Button onAction="#applyFilters" text="Aplicar filtros" />

                </HBox>

                <!-- TABLA -->

                <VBox spacing="15" styleClass="card">

                    <HBox alignment="CENTER_LEFT">

                        <VBox spacing="3">

                            <Label style="-fx-font-size: 20px;                                       -fx-font-weight: bold;" text="Cursos del Estudiante" />

                            <Label styleClass="subtitle" text="Historial académico" />

                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <Label styleClass="badge" text="Expediente" />

                    </HBox>

                    <TableView fx:id="tblCourses" prefHeight="416.0" prefWidth="822.0">
                        <columns>
                            <TableColumn fx:id="colCode" prefWidth="120" text="Código" />
                            <TableColumn fx:id="colName" prefWidth="320" text="Curso" />
                            <TableColumn fx:id="colCredits" prefWidth="100" text="Créditos" />
                            <TableColumn fx:id="colGrade" prefWidth="100" text="Nota" />
                            <TableColumn fx:id="colStatus" prefWidth="160" text="Estado" />
                        </columns>
                    </TableView>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>