<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="cr.ac.ucr.sga.controller.RecordController"
            stylesheets="@../styles.css"
            styleClass="root">

    <!-- =========================
         HEADER
    ========================== -->

    <top>

        <HBox spacing="20"
              alignment="CENTER_LEFT"
              styleClass="header-bar">

            <padding>
                <Insets top="18"
                        right="24"
                        bottom="18"
                        left="24"/>
            </padding>

            <Label text="SGA"
                   styleClass="header-badge"/>

            <VBox spacing="2">

                <Label text="Expediente Académico"
                       styleClass="header-title"/>

                <Label text="Historial ordenado cronológicamente"
                       styleClass="header-sub"/>

                <Label fx:id="lblStudentInfo"
                       styleClass="header-badge"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- SOLO ADMIN -->

            <VBox spacing="5"
                  alignment="CENTER_RIGHT">

                <Label text="Seleccionar estudiante"
                       styleClass="subtitle"/>

                <ComboBox fx:id="cmbStudents"
                          prefWidth="250"
                          onAction="#onStudentSelected"/>

            </VBox>

            <Button text="Exportar PDF"
                    styleClass="btn-secondary"/>

        </HBox>

    </top>

    <!-- =========================
         CONTENT
    ========================== -->

    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="25"
                        right="25"
                        bottom="25"
                        left="25"/>
            </padding>

            <!-- RESUMEN -->

            <HBox spacing="20">

                <!-- PROMEDIO -->

                <VBox spacing="10"
                      styleClass="card"
                      prefWidth="240">

                    <Label text="Promedio General"
                           styleClass="subtitle"/>

                    <Label fx:id="lblAvg"
                           style="-fx-font-size:32px;
                                  -fx-font-weight:bold;
                                  -fx-text-fill:#5562EA;"/>

                    <Label fx:id="lblAvgDesc"
                           styleClass="badge"/>

                </VBox>

                <!-- CREDITOS -->

                <VBox spacing="10"
                      styleClass="card"
                      prefWidth="240">

                    <Label text="Créditos Aprobados"
                           styleClass="subtitle"/>

                    <Label fx:id="lblCredits"
                           style="-fx-font-size:32px;
                                  -fx-font-weight:bold;
                                  -fx-text-fill:#2DBE8D;"/>

                    <Label fx:id="lblCreditosDesc"
                           styleClass="badge"/>

                </VBox>

                <!-- CURSOS -->

                <VBox spacing="10"
                      styleClass="card"
                      prefWidth="240">

                    <Label text="Cursos Matriculados"
                           styleClass="subtitle"/>

                    <Label fx:id="lblCount"
                           style="-fx-font-size:32px;
                                  -fx-font-weight:bold;
                                  -fx-text-fill:#E85D75;"/>

                    <Label fx:id="lblCiclo"
                           styleClass="badge"/>

                </VBox>

            </HBox>

            <!-- FILTROS -->

            <HBox spacing="15"
                  alignment="CENTER_LEFT">

                <TextField promptText="Buscar curso..."
                           prefWidth="250"/>

                <ComboBox promptText="Filtrar por ciclo"
                          prefWidth="180"/>

                <ComboBox promptText="Estado"
                          prefWidth="180"/>

                <Button text="Aplicar filtros"/>

            </HBox>

            <!-- TABLA -->

            <VBox spacing="15"
                  styleClass="card">

                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="3">

                        <Label text="Cursos del Estudiante"
                               style="-fx-font-size: 20px;
                                      -fx-font-weight: bold;"/>

                        <Label text="Historial académico"
                               styleClass="subtitle"/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="Expediente"
                           styleClass="badge"/>

                </HBox>

                <TableView fx:id="tblCourses"
                           prefHeight="400">

                    <columns>

                        <TableColumn fx:id="colCode"
                                     text="Código"
                                     prefWidth="120"/>

                        <TableColumn fx:id="colName"
                                     text="Curso"
                                     prefWidth="320"/>

                        <TableColumn fx:id="colCredits"
                                     text="Créditos"
                                     prefWidth="100"/>

                        <TableColumn fx:id="colGrade"
                                     text="Nota"
                                     prefWidth="100"/>

                        <TableColumn fx:id="colStatus"
                                     text="Estado"
                                     prefWidth="160"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </center>

</BorderPane>