<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="cr.ac.ucr.sga.controller.StudentController"
            prefWidth="1200"
            prefHeight="700"
            styleClass="root-pane"
            stylesheets="@../styles.css">

    <!-- HEADER -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="15"
              styleClass="header-bar">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <Label text="SGA"
                   styleClass="header-badge"/>

            <VBox spacing="2">

                <Label text="Sistema de Gestión Académica"
                       styleClass="header-title"/>

                <Label text="Administración de estudiantes"
                       styleClass="header-sub"/>

            </VBox>

        </HBox>

    </top>

    <!-- CENTER -->

    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <!-- FORM PANEL -->

            <VBox spacing="18"
                  styleClass="panel">

                <Label text="Registro de Estudiantes"
                       styleClass="panel-title"/>

                <GridPane hgap="18"
                          vgap="12">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <!-- ID -->

                    <Label text="Identificación"
                           styleClass="section-label"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="txtId"
                               promptText="Ingrese identificación"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="0"/>

                    <!-- NAME -->

                    <Label text="Nombre Completo"
                           styleClass="section-label"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                    <TextField fx:id="txtName"
                               promptText="Ingrese nombre completo"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>

                    <!-- AGE -->

                    <Label text="Edad"
                           styleClass="section-label"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="txtAge"
                               promptText="Ingrese edad"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="0"/>

                    <!-- CARNET -->

                    <Label text="Carnet"
                           styleClass="section-label"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>

                    <TextField fx:id="txtCarnet"
                               promptText="Ingrese carnet"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="1"/>

                    <!-- USERNAME -->

                    <Label text="Usuario"
                           styleClass="section-label"
                           GridPane.rowIndex="4"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="txtUsername"
                               promptText="Ingrese usuario"
                               GridPane.rowIndex="5"
                               GridPane.columnIndex="0"/>

                    <!-- PASSWORD -->

                    <Label text="Contraseña"
                           styleClass="section-label"
                           GridPane.rowIndex="4"
                           GridPane.columnIndex="1"/>

                    <PasswordField fx:id="txtPassword"
                                   promptText="Ingrese contraseña"
                                   GridPane.rowIndex="5"
                                   GridPane.columnIndex="1"/>

                </GridPane>

                <!-- BUTTONS -->

                <HBox spacing="12">

                    <Button text="Agregar"
                            fx:id="btnAdd"
                            onAction="#addStudent"
                            styleClass="btn-primary"/>

                    <Button text="Actualizar"
                            fx:id="btnUpdate"
                            onAction="#updateStudent"
                            styleClass="btn-accent"/>

                    <Button text="Eliminar"
                            fx:id="btnDelete"
                            onAction="#deleteStudent"
                            styleClass="btn-gray"/>

                    <Button text="Limpiar"
                            fx:id="btnClear"
                            onAction="#clearFields"
                            styleClass="btn-ghost"/>

                </HBox>

            </VBox>

            <!-- TABLE PANEL -->

            <VBox spacing="10"
                  styleClass="panel">

                <HBox alignment="CENTER_LEFT"
                      spacing="10">

                    <Label text="Lista de Estudiantes"
                           styleClass="panel-title"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="0 registros"
                           fx:id="lblCount"
                           styleClass="header-tag"/>

                </HBox>

                <VBox styleClass="custom-table-container">

                    <TableView fx:id="tblStudents"
                               styleClass="custom-table"
                               prefHeight="350">

                        <columns>

                            <TableColumn fx:id="colId"
                                         text="ID"
                                         prefWidth="150"/>

                            <TableColumn fx:id="colName"
                                         text="Nombre"
                                         prefWidth="240"/>

                            <TableColumn fx:id="colAge"
                                         text="Edad"
                                         prefWidth="100"/>

                            <TableColumn fx:id="colCarnet"
                                         text="Carnet"
                                         prefWidth="170"/>

                            <TableColumn fx:id="colUsername"
                                         text="Usuario"
                                         prefWidth="170"/>

                        </columns>

                    </TableView>

                </VBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>