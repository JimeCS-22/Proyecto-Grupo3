<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.ucr.sga.controller.EnrollmentStudentController">

    <!-- =========================
         HEADER
    ========================== -->

    <top>

        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header-bar">

            <padding>
                <Insets bottom="18" left="24" right="24" top="18" />
            </padding>

            <Label styleClass="header-badge" text="SGA" />

            <VBox spacing="2">

                <Label styleClass="header-title" text="Matrícula Académica" />

                <Label styleClass="header-sub" text="Solicitud de revisión de proyectos de matrícula" />

            </VBox>

        </HBox>

    </top>

    <!-- =========================
         CONTENT
    ========================== -->

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" vbarPolicy="AS_NEEDED">
            <VBox spacing="20">

                <padding>
                    <Insets bottom="25" left="25" right="25" top="25" />
                </padding>

                <!-- FORM -->

                <VBox prefHeight="202.0" prefWidth="515.0" spacing="20" styleClass="card">

                    <Label style="-fx-font-size: 20px;                               -fx-font-weight: bold;" text="Solicitud de matrícula" />

                    <!-- ESTUDIANTE -->

                    <VBox spacing="8" />

                    <!-- CURSO -->

                    <VBox prefHeight="79.0" prefWidth="305.0" spacing="8">

                        <Label styleClass="subtitle" text="Seleccionar Curso" />

                        <ComboBox fx:id="cmbCourses" promptText="Seleccione un curso" />
                    </VBox>
               <Button fx:id="btnAddCourse" alignment="CENTER" onAction="#assignCourse" styleClass="btn-success" text="Agregar curso" textAlignment="CENTER" />

                </VBox>
            <VBox prefHeight="63.0" prefWidth="734.0" spacing="20" styleClass="card">
               <children>
                  <Label style="-fx-font-size: 20px;                               -fx-font-weight: bold;" text="Prioridad de matrícula" />
                  <HBox prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <Label prefHeight="18.0" prefWidth="187.0" text="Tu prioridad de matrícula es: " />
                        <Label fx:id="lblPriority" prefHeight="18.0" prefWidth="187.0" text="--" />
                     </children>
                  </HBox>
               </children>
            </VBox>

                <!-- TABLE -->

                <VBox prefWidth="734.0" spacing="15" styleClass="card">
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Cursos Seleccionados" />
                    <TableView fx:id="tblEnrollments" minHeight="100.0" prefHeight="170.0" styleClass="custom-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colCourse" prefWidth="230" text="Curso" />
                            <TableColumn fx:id="colCredits" prefWidth="194.0" text="Créditos" />
                        </columns>
                    </TableView>
               <HBox alignment="CENTER" prefHeight="33.0" prefWidth="694.0">
                  <children>
      
                           <!-- BUTTON -->
      
                           <Button fx:id="btnSolicitudMatricula" alignment="CENTER" onAction="#sendEnrollmentRequest" styleClass="btn-success" text="Enviar solicitud de matrícula" textAlignment="CENTER" />
                  </children>
               </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
