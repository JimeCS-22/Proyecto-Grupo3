<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="cr.ac.ucr.sga.controller.TreeVisualizerController">

    <top>
        <VBox spacing="10" style="-fx-padding:15;">
            <Label style="-fx-font-size:24px; -fx-font-weight:bold;" text="Visualizador de Árboles de Cursos" />


            <HBox spacing="10">
                <Label text="Tipo de Árbol:" />
                <ComboBox fx:id="treeTypeCombo" onAction="#onTreeTypeChanged" prefWidth="180" />

                <Label text="Buscar:" />
                <TextField fx:id="searchField" promptText="Código del curso" />
                <Button onAction="#onSearchCourse" text="Buscar" />

                <Label text="Carreras:">
                    <HBox.margin>
                        <Insets left="100.0" />
                    </HBox.margin>
                </Label>

                <ComboBox fx:id="cmbCarreras" prefHeight="25.0" prefWidth="168.0" />
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox prefWidth="220" spacing="10" style="-fx-padding:10;">
            <Label style="-fx-font-size:18px;" text="Recorridos" />
            <Button maxWidth="Infinity" onAction="#onInOrder" text="InOrden" />
            <Button maxWidth="Infinity" onAction="#onPreOrder" text="PreOrden" />
            <Button maxWidth="Infinity" onAction="#onPostOrder" text="PostOrden" />
            <Separator />
            <Label text="Animaciones" />
            <Button maxWidth="Infinity" onAction="#onAnimatedSearch" text="Buscar Animado" />
            <Button maxWidth="Infinity" onAction="#onShowAVLInfo" text="Mostrar AVL" />
            <Separator />
            <Label text="Rotaciones AVL" />
            <ComboBox fx:id="rotationCombo" prefWidth="180" />
            <Button maxWidth="Infinity" onAction="#onRotationDemo" text="Demostrar Rotación" />
        </VBox>
    </left>

    <center>
        <SplitPane dividerPositions="0.75" orientation="VERTICAL">
            <ScrollPane fx:id="scrollPane" fitToHeight="false" fitToWidth="false" pannable="true">
                <content>
                    <Group fx:id="canvasGroup">
                        <Canvas fx:id="treeCanvas" height="2000" width="3000" />
                    </Group>
                </content>
            </ScrollPane>

            <VBox spacing="5" style="-fx-padding:10;">
                <Label style="-fx-font-weight:bold;" text="Resultado" />
                <TextArea fx:id="resultArea" editable="false" VBox.vgrow="ALWAYS" />
            </VBox>
        </SplitPane>
    </center>

</BorderPane>