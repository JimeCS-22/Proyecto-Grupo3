<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="cr.ac.ucr.sga.controller.CourseController"
            styleClass="root-pane"
            stylesheets="@../styles.css">

    <!-- TOP -->

    <top>

        <VBox spacing="15"
              styleClass="panel">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <Label text="Administración de Cursos"
                   styleClass="panel-title"/>

            <GridPane hgap="15"
                      vgap="10">

                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <!-- Código -->

                <Label text="Código"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="txtId"
                           promptText="Código del curso"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"/>

                <!-- Nombre -->

                <Label text="Nombre"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="1"/>

                <TextField fx:id="txtName"
                           promptText="Nombre del curso"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"/>

                <!-- Créditos -->

                <Label text="Créditos"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="txtCredits"
                           promptText="Cantidad de créditos"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="0"/>

                <!-- Estado -->

                <Label text="Estado"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="1"/>

                <ComboBox fx:id="cmbStatus"
                          GridPane.rowIndex="3"
                          GridPane.columnIndex="1"/>

            </GridPane>

            <!-- BOTONES -->

            <HBox spacing="10">

                <Button fx:id="btnAdd"
                        text="Agregar"
                        onAction="#addCourse"
                        styleClass="btn-primary"/>

                <Button fx:id="btnUpdate"
                        text="Actualizar"
                        onAction="#updateCourse"
                        styleClass="btn-accent"/>

                <Button fx:id="btnDelete"
                        text="Eliminar"
                        onAction="#deleteCourse"
                        styleClass="btn-gray"/>

                <Button fx:id="btnClear"
                        text="Limpiar"
                        onAction="#clearFields"
                        styleClass="btn-ghost"/>

            </HBox>

        </VBox>

    </top>

    <!-- CENTER -->

    <center>

        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;">

            <content>

                <FlowPane fx:id="coursesContainer"
                          hgap="20"
                          vgap="20"
                          prefWrapLength="1000">

                    <padding>
                        <Insets top="20"
                                right="20"
                                bottom="20"
                                left="20"/>
                    </padding>

                </FlowPane>

            </content>

        </ScrollPane>

    </center>

</BorderPane>